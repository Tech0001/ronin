{
  "name": "ronin",
  "private": true,
  "version": "1.1.1",
  "description": "Lightweight Rust + Tauri desktop workspace for running persistent terminals and AI coding agents in movable panels.",
  "repository": "https://github.com/Tech0001/ronin",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:release": "npm run build && cargo build --release --manifest-path src-tauri/Cargo.toml -p ronin-daemon && cargo build --release --manifest-path src-tauri/Cargo.toml -p ronin --features custom-protocol",
    "package:linux": "bash scripts/package-linux.sh",
    "install:linux": "npm run build:release && bash scripts/install-desktop.sh",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
